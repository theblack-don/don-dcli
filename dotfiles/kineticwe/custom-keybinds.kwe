# KineticWE custom keybinds — generated by Kinetic Settings.
# Each entry adds one action to the Applications / Custom Commands
# keybinds categories; chords live in keybinds.kwe and the daemon.
[applications]
dev.zed.Zed=Zed
dev.kineticwe.Settings=Kinetic Settings
com.linuxgamerlife.lgl-papercutter=LGL Papercutter
com.mitchellh.ghostty=Ghostty
com.obsproject.Studio=OBS Studio
kitty=kitty
steam=Steam
veadotube-mini=veadotube mini
fifine-control-deck=fifine Control Deck
com.linuxgamerlife.lgl-emoji-picker=LGL Emoji Picker
helium=Helium
firebotv5=Firebot v5
lgl-vm-curator=LGL VM Curator
nemo=Files
org.telegram.desktop=Telegram
equibop=Equibop
[applications:exec]
dev.zed.Zed=/home/don/.local/zed.app/bin/zed
dev.kineticwe.Settings=sh -c "noctalia-kwe msg kinetic-settings-open || { noctalia-kwe --daemon && noctalia-kwe msg kinetic-settings-open; }"
com.linuxgamerlife.lgl-papercutter=lgl-papercutter
com.mitchellh.ghostty=/usr/bin/ghostty --gtk-single-instance=true
com.obsproject.Studio=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=obs com.obsproject.Studio
kitty=kitty
steam=/usr/bin/steam
veadotube-mini=/home/don/Documents/veadotube-mini
fifine-control-deck=/home/don/Documents/fifine-control-deck-0.12.8-x86_64.AppImage
com.linuxgamerlife.lgl-emoji-picker=lgl-emoji-picker
helium=helium-browser-bin --enable-features=VaapiVideoDecoder,PlatformHEVCDecoderSupport
firebotv5=firebotv5
lgl-vm-curator=kitty -e lgl-vm-curator
nemo=nemo
org.telegram.desktop=/usr/bin/telegram-desktop
equibop=equibop
[custom-commands]
cmd-6=kitty --hold fastfetch
cmd-7=ghostty --wait-after-command -e ki
cmd-8=ghostty --wait-after-command -e fastfetch
cmd-9=noctalia-kwe msg panel-toggle theblackdon/theme-switcher:wallpapers
cmd-10=noctalia-kwe msg plugin theblackdon/theme-switcher:wallpaper-ipc all next
cmd-11=ghostty -e kx
cmd-12=ds4u
cmd-13=kwepaperpicker toggle
cmd-14=kwepaperpicker
cmd-15=spectacle -b -r
[custom-commands:exec]
cmd-6=kitty --hold fastfetch
cmd-7=ghostty --wait-after-command -e ki
cmd-8=ghostty --wait-after-command -e fastfetch
cmd-9=noctalia-kwe msg panel-toggle theblackdon/theme-switcher:wallpapers
cmd-10=noctalia-kwe msg plugin theblackdon/theme-switcher:wallpaper-ipc all next
cmd-11=ghostty -e kx
cmd-12=ds4u
cmd-13=kwepaperpicker toggle
cmd-14=kwepaperpicker
cmd-15=spectacle -b -r
