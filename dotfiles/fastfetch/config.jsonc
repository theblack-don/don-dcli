{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/BlackDon/logos/nix_fedora2.txt",
    "width": 40,
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "#c5c4db",
      "2": "#c7c5cf",
      "3": "#ffffff",
      "4": "#c8c80a",
      "6": "#905e29",
      "7": "#c8bf84",
      "8": "#c81619",
      "9": "#0a0a0a"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#c5c4db",
      "title": "#c7c5cf"
    },
    "percent": {
      "color": {
        "green": "#ddbecf",
        "yellow": "#c5c4db",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}╭────── User : {#}{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}System Information"
    },
    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹 OS"
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 Uptime"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰏓 Native      ",
      "text": "n=$(env -u LD_LIBRARY_PATH python3 -c 'import sqlite3,sys; print(sqlite3.connect(\"file:\"+sys.argv[1]+\"?mode=ro\", uri=True).execute(\"SELECT count(*) FROM Sigmd5\").fetchone()[0])' \"$(env -u LD_LIBRARY_PATH rpm --eval \"%{_dbpath}\")/rpmdb.sqlite\" 2>/dev/null) || n=$(env -u LD_LIBRARY_PATH rpm -qa 2>/dev/null | grep -vc '^gpg-pubkey-'); a=$(find \"$HOME/AppImages\" \"$HOME/Applications\" -maxdepth 1 -iname '*.appimage' 2>/dev/null | wc -l); printf '%s (rpm), %s (appimage)' \"$n\" \"$a\""
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏓 Flatpaks    ",
      "disabled": [
        "am",
        "apk",
        "appimage",
        "brew",
        "cards",
        "choco",
        "crux",
        "dpkg",
        "emerge",
        "eopkg",
        "guix",
        "hpkg",
        "installrelease",
        "kiss",
        "linglong",
        "lpkg",
        "lpkgbuild",
        "macports",
        "moss",
        "mport",
        "nix",
        "opkg",
        "pacman",
        "pacstall",
        "paludis",
        "pisi",
        "pkg",
        "pkgsrc",
        "pkgtool",
        "porg",
        "rpm",
        "rum",
        "scoop",
        "snap",
        "soar",
        "sorcery",
        "winget",
        "xbps"
      ]
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys} Nix Packages",
      "text": "p=\"$HOME/.nix-profile\"; [ -d \"$p\" ] || exit 1; out=$(env -u LD_LIBRARY_PATH nix-store -q --requisites \"$p\" 2>/dev/null) || exit 1; printf '%s\\n' \"$out\" | awk -F/ '{n=$NF; if (n ~ /[0-9]\\.[0-9]/ && n !~ /-(doc|man|info|dev|bin)$/) c++} END {print c+0}'",
      "format": "{} (nix-user)"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Desktop Environment"
    },
    {
      "type": "de",
      "key": "{#separator}│  {#keys}󰧨 DE"
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys}󱂬 WM"
    },
    {
      "type": "wmtheme",
      "key": "{#separator}│  {#keys}󰉼 Theme"
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 Shell"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Hardware Information"
    },
    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮 GPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰍹 GPU Driver",
      "format": "{driver}"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󰋊 Disk (/)",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "{#1}╰───────────────────────────────╯"
    }
  ]
}
