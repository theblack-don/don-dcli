#!/usr/bin/env bash
# noctalia-msg: send a Noctalia IPC command to whichever shell is running.
#
# Usage:
#   noctalia-msg plugin theblackdon/theme-switcher:wallpaper-ipc all apply "Gruvbox"
#   noctalia-msg msg plugin theblackdon/theme-switcher:wallpaper-ipc all apply "Gruvbox"
#   noctalia-msg status
#
# Works with upstream Noctalia (Umbriel) and the KineticWE fork:
#   Umbriel   -> /usr/bin/noctalia      + noctalia-<display>.sock
#   KineticWE -> noctalia-kwe           + noctalia-kwe-<display>.sock
set -euo pipefail

# Allow both "noctalia-msg <command>" and "noctalia-msg msg <command>".
if [[ ${1:-} == "msg" ]]; then
    shift
fi

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
display="${WAYLAND_DISPLAY:-wayland-0}"
desktop="${XDG_CURRENT_DESKTOP:-${XDG_SESSION_DESKTOP:-${DESKTOP_SESSION:-}}}"
desktop="${desktop,,}"

first_executable() {
    local candidate
    for candidate in "$@"; do
        if [[ -x $candidate ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

stable_bin() {
    first_executable \
        /usr/bin/noctalia \
        /usr/local/bin/noctalia \
        "$HOME/.local/bin/noctalia" \
        "$HOME/.nix-profile/bin/noctalia"
}

kwe_bin() {
    first_executable \
        "$HOME/.local/bin/noctalia-kwe" \
        /usr/bin/noctalia-kwe \
        "$HOME/.nix-profile/bin/noctalia-kwe" \
        "$HOME/.local/state/kineticwe/nix/noctalia/bin/noctalia-kwe"
}

bin=""
case "$desktop" in
    *umbriel*)
        bin="$(stable_bin || true)"
        ;;
    *kinetic*)
        bin="$(kwe_bin || true)"
        ;;
esac

# If the session variable did not decide it, trust the live IPC socket.
if [[ -z $bin ]]; then
    if [[ -S "$runtime/noctalia-kwe-${display}.sock" ]]; then
        bin="$(kwe_bin || true)"
    elif [[ -S "$runtime/noctalia-${display}.sock" ]]; then
        bin="$(stable_bin || true)"
    fi
fi

# Last resort: whichever binary is installed. Prefer upstream.
if [[ -z $bin ]]; then
    bin="$(stable_bin || kwe_bin || true)"
fi

if [[ -z $bin ]]; then
    message="noctalia-msg: neither noctalia nor noctalia-kwe was found"
    echo "$message" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Noctalia" "noctalia-msg" "$message" 2>/dev/null || true
    fi
    exit 127
fi

exec "$bin" msg "$@"
