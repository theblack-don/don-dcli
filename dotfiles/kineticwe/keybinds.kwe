# KineticWE keybinds — generated by Kinetic Settings. Only binds that
# differ from the defaults are stored. Copy this file into your dotfiles
# (or to another machine's ~/.config/kineticwe/) to share your binds; it
# is re-applied at every session start.
[kineticwe][Global Shortcuts]
Decrease Opacity=Meta+-
Increase Opacity=Meta+=
Window On All Desktops=Meta+K
Window Fullscreen=Alt+F
Window Minimize=Meta+A
Show Desktop=Meta+P
Switch to Screen to the Left=Meta+Ctrl+Left
Switch to Screen to the Right=Meta+Ctrl+Right
Tiling Consume Window=Meta+C
Tiling Cycle Layout=Ctrl+ 
Tiling Switch Column Width Preset=Alt+ 
Tiling Expel Window=Meta+E
Tiling Toggle Floating=Meta+W
Tiling Toggle Outer Gaps=Ctrl+Shift+ 
Grid View=Meta+X
Overview=Meta+Alt+X
Toggle Title Bars=Alt+T
Walk Through Windows=Meta+H
Window One Desktop Down=Meta+Ctrl+Alt+Down
Window One Desktop Up=Meta+Ctrl+Alt+Up
Window to Desktop 1=Meta+!
[noctalia][Global Shortcuts]
NoctaliaToggleBar=Meta+Shift+B
NoctaliaToggleClipboard=Meta+Shift+C
NoctaliaDockToggle=Meta+Shift+D
NoctaliaToggleWallpaperPicker=Meta+Shift+W
[applications][Global Shortcuts]
com.discordapp.Discord=Meta+D
fifine-control-deck=Ctrl+Alt+F
nemo=Meta+F
firebotv5=Meta+Shift+F
com.mitchellh.ghostty=Meta+T
helium=Meta+B
dev.kineticwe.Settings=Meta+Alt+S
kitty=Meta+Ctrl+T
com.linuxgamerlife.lgl-emoji-picker=Meta+Alt+E
com.linuxgamerlife.lgl-papercutter=Meta+Ctrl+W
lgl-vm-curator=Meta+Alt+V
com.obsproject.Studio=Meta+O
steam=Meta+S
org.telegram.desktop=Meta+G
veadotube-mini=Meta+V
dev.zed.Zed=Meta+Z
[custom-commands][Global Shortcuts]
cmd-8=Meta+Alt+F
cmd-7=Meta+Shift+X
cmd-12=Meta+Alt+D
cmd-11=Meta+Alt+K
cmd-6=Meta+Ctrl+F
cmd-14=Ctrl+Alt+Shift+W
cmd-13=Alt+Shift+W
cmd-9=Meta+Alt+W
cmd-10=Meta+R
[org.kde.spectacle.desktop][Global Shortcuts]
RectangularRegionScreenShot=Meta+Shift+S
