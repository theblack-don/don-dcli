{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "#b7b7b7",
      "2": "#939393"
    },
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#f5c2e7",
      "title": "#fab387"
    },
    "percent": {
      "color": {
        "green": "#94e2d5",
        "yellow": "#ed91d4",
        "red": "#f38ba8"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}╭────── User : {#}{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}System Information"
    },
    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹 OS"
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 Uptime"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰏓 AppImages   ",
      "text": "a=$(find \"$HOME/AppImages\" \"$HOME/Applications\" -maxdepth 1 -iname '*.appimage' 2>/dev/null | wc -l); printf '%s' \"$a\""
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏓 Flatpaks    ",
      "disabled": [
        "am",
        "apk",
        "appimage",
        "brew",
        "cards",
        "choco",
        "crux",
        "dpkg",
        "emerge",
        "eopkg",
        "guix",
        "hpkg",
        "installrelease",
        "kiss",
        "linglong",
        "lpkg",
        "lpkgbuild",
        "macports",
        "moss",
        "mport",
        "nix",
        "opkg",
        "pacman",
        "pacstall",
        "paludis",
        "pisi",
        "pkg",
        "pkgsrc",
        "pkgtool",
        "porg",
        "rpm",
        "rum",
        "scoop",
        "snap",
        "soar",
        "sorcery",
        "winget",
        "xbps"
      ]
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰏓 Nix Profile ",
      "text": "p=\"$HOME/.nix-profile\"; [ -d \"$p\" ] || exit 1; out=$(env -u LD_LIBRARY_PATH nix-store -q --requisites \"$p\" 2>/dev/null) || exit 1; printf '%s\\n' \"$out\" | awk -F/ '{n=$NF; if (n ~ /[0-9]\\.[0-9]/ && n !~ /-(doc|man|info|dev|bin)$/) c++} END {print c+0}'",
      "format": "{} (nix-user)"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰏓 Nix System  ",
      "text": "p=\"/run/current-system\"; [ -d \"$p\" ] || exit 1; out=$(env -u LD_LIBRARY_PATH nix-store -q --requisites \"$p\" 2>/dev/null) || exit 1; printf '%s\\n' \"$out\" | awk -F/ '{n=$NF; if (n ~ /[0-9]\\.[0-9]/ && n !~ /-(doc|man|info|dev|bin)$/) c++} END {print c+0}'",
      "format": "{} (nix-system)"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Desktop Environment"
    },
    {
      "type": "de",
      "key": "{#separator}│  {#keys}󰧨 DE"
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys}󱂬 WM"
    },
    {
      "type": "wmtheme",
      "key": "{#separator}│  {#keys}󰉼 Theme"
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 Shell"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Hardware Information"
    },
    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮 GPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰍹 GPU Driver",
      "format": "{driver}"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󰋊 Disk (/)",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "{#1}╰───────────────────────────────╯"
    }
  ]
}
