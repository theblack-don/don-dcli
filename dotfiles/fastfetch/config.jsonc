{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/BlackDon/logos/nix_fedora2.txt",
    "width": 40,
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "#c7c0f7",
      "2": "#c8c3db",
      "3": "#ffffff",
      "4": "#c8c80a",
      "6": "#905e29",
      "7": "#c8bf84",
      "8": "#c81619",
      "9": "#0a0a0a"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#c7c0f7",
      "title": "#c8c3db"
    },
    "percent": {
      "color": {
        "green": "#f2b4d8",
        "yellow": "#c7c0f7",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}╭────── User : {#}{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}System Information"
    },
    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹 OS"
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏓 Native  ",
      "disabled": [
        "nix",
        "flatpak"
      ]
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏓 Flatpaks",
      "disabled": [
        "am",
        "apk",
        "appimage",
        "brew",
        "cards",
        "choco",
        "crux",
        "dpkg",
        "emerge",
        "eopkg",
        "guix",
        "hpkg",
        "installrelease",
        "kiss",
        "linglong",
        "lpkg",
        "lpkgbuild",
        "macports",
        "moss",
        "mport",
        "nix",
        "opkg",
        "pacman",
        "pacstall",
        "paludis",
        "pisi",
        "pkg",
        "pkgsrc",
        "pkgtool",
        "porg",
        "rpm",
        "rum",
        "scoop",
        "snap",
        "soar",
        "sorcery",
        "winget",
        "xbps"
      ]
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys} Nix     ",
      "disabled": [
        "am",
        "apk",
        "appimage",
        "brew",
        "cards",
        "choco",
        "crux",
        "dpkg",
        "emerge",
        "eopkg",
        "flatpak",
        "guix",
        "hpkg",
        "installrelease",
        "kiss",
        "linglong",
        "lpkg",
        "lpkgbuild",
        "macports",
        "moss",
        "mport",
        "opkg",
        "pacman",
        "pacstall",
        "paludis",
        "pisi",
        "pkg",
        "pkgsrc",
        "pkgtool",
        "porg",
        "rpm",
        "rum",
        "scoop",
        "snap",
        "soar",
        "sorcery",
        "winget",
        "xbps"
      ]
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Desktop Environment"
    },
    {
      "type": "de",
      "key": "{#separator}│  {#keys}󰧨 DE"
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys}󱂬 WM"
    },
    {
      "type": "wmtheme",
      "key": "{#separator}│  {#keys}󰉼 Theme"
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 Shell"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Hardware Information"
    },
    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮 GPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰍹 GPU Driver",
      "format": "{driver}"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󰋊 Disk (/)",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "{#1}╰───────────────────────────────╯"
    }
  ]
}
